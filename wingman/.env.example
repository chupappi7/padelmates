# Server-only (API routes). Never prefix with EXPO_PUBLIC_.
ANTHROPIC_API_KEY=

# Optional shared key; if set, the API routes reject requests without it.
WINGMAN_APP_KEY=

# App side. Leave EXPO_PUBLIC_API_URL empty for local web dev; set it to the
# deployed EAS Hosting URL for phone builds.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_WINGMAN_KEY=
